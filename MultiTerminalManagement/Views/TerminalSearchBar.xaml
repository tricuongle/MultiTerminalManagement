<UserControl x:Class="MultiTerminalManagement.Views.TerminalSearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#252526">
    <Border Background="#252526" BorderBrush="#3e3e3e" BorderThickness="0,0,0,1" Padding="6,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox" Grid.Column="0"
                     Background="#1e1e1e" Foreground="#E0E0E0" CaretBrush="#E0E0E0"
                     BorderBrush="#3e3e3e" BorderThickness="1"
                     FontFamily="Consolas" FontSize="13"
                     Padding="6,3"
                     TextChanged="SearchTextBox_TextChanged"
                     PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>

            <TextBlock x:Name="MatchCount" Grid.Column="1"
                       Text="0/0" Foreground="#888" FontSize="11"
                       VerticalAlignment="Center" Margin="6,0"/>

            <Button Grid.Column="2" Content="&#x25B2;" FontSize="10"
                    Click="Previous_Click"
                    Background="Transparent" Foreground="#E0E0E0"
                    BorderThickness="0" Cursor="Hand"
                    Padding="6,2" ToolTip="Previous (Shift+F3)"/>

            <Button Grid.Column="3" Content="&#x25BC;" FontSize="10"
                    Click="Next_Click"
                    Background="Transparent" Foreground="#E0E0E0"
                    BorderThickness="0" Cursor="Hand"
                    Padding="6,2" ToolTip="Next (F3)"/>

            <Button Grid.Column="4" Content="&#x2715;" FontSize="10"
                    Click="Close_Click"
                    Background="Transparent" Foreground="#999"
                    BorderThickness="0" Cursor="Hand"
                    Padding="6,2" ToolTip="Close (Escape)"/>
        </Grid>
    </Border>
</UserControl>
