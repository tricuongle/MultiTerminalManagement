<Window x:Class="MultiTerminalManagement.Views.SnippetPickerPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Snippet"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="420"
        MaxHeight="380"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#252526" BorderBrush="#c27d1a" BorderThickness="1" CornerRadius="6"
            Margin="8" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Opacity="0.6" ShadowDepth="4" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search box -->
            <Border Grid.Row="0" Background="#1e1e1e" Padding="8" CornerRadius="6,6,0,0">
                <TextBox x:Name="SearchBox"
                         Background="#1e1e1e"
                         Foreground="#E0E0E0"
                         CaretBrush="#E0E0E0"
                         BorderBrush="#3e3e3e"
                         BorderThickness="1"
                         FontSize="14"
                         FontFamily="Consolas"
                         Padding="8,6"
                         TextChanged="SearchBox_TextChanged"/>
            </Border>

            <!-- Results list -->
            <ListBox x:Name="ResultsList" Grid.Row="1"
                     Background="#252526"
                     BorderThickness="0"
                     Padding="4"
                     MaxHeight="280"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent"
                                            Padding="8,6" Margin="0,1" CornerRadius="3"
                                            Cursor="Hand">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#094771"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2a2d2e"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#c27d1a" CornerRadius="3" Padding="4,1"
                                        VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Category}" Foreground="White"
                                               FontSize="9" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" Foreground="#E0E0E0"
                                           FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Command}" Foreground="#888"
                                       FontSize="11" FontFamily="Consolas"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
