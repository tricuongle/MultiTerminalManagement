<Window x:Class="MultiTerminalManagement.Views.SnippetManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snippet Manager"
        Width="620" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e1e">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Snippet list grouped by category -->
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="+ Add" Click="Add_Click" Padding="8,3"
                        Background="#0e639c" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Delete" Click="Delete_Click" Padding="8,3" Margin="4,0,0,0"
                        Background="#442222" Foreground="#cc6666" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
            <ListBox x:Name="SnippetList" Background="#252526" Foreground="#E0E0E0"
                     BorderBrush="#3e3e3e" SelectionChanged="SnippetList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#E0E0E0"/>
                        <Setter Property="Padding" Value="6,4"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <!-- Edit form -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="Name:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
            <TextBox x:Name="SnipNameBox" Grid.Row="0" Grid.Column="1"
                     Background="#2d2d2d" Foreground="#CCCCCC" CaretBrush="#CCCCCC"
                     BorderBrush="#3e3e3e" Padding="4"/>

            <TextBlock Grid.Row="2" Text="Category:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
            <TextBox x:Name="SnipCatBox" Grid.Row="2" Grid.Column="1"
                     Background="#2d2d2d" Foreground="#CCCCCC" CaretBrush="#CCCCCC"
                     BorderBrush="#3e3e3e" Padding="4"/>

            <TextBlock Grid.Row="4" Text="Command:" Foreground="#CCCCCC" VerticalAlignment="Top"/>
            <TextBox x:Name="SnipCmdBox" Grid.Row="4" Grid.Column="1" Grid.RowSpan="3"
                     Background="#2d2d2d" Foreground="#CCCCCC" CaretBrush="#CCCCCC"
                     BorderBrush="#3e3e3e" Padding="4"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="13"
                     ToolTip="Use {{variable}} for placeholders"/>

            <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Save Snippet" Click="Save_Click" Padding="12,4"
                        Background="#0e639c" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Close" Click="Close_Click" Padding="12,4" Margin="8,0,0,0"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
