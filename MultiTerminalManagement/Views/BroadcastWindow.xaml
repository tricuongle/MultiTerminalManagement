<Window x:Class="MultiTerminalManagement.Views.BroadcastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Broadcast"
        Width="420" Height="320"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Background="#1e1e1e">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input area -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommandBox"
                     Grid.Column="0"
                     Background="#2d2d2d"
                     Foreground="#CCCCCC"
                     CaretBrush="#CCCCCC"
                     BorderBrush="#3e3e3e"
                     Padding="6,4"
                     FontFamily="Consolas"
                     FontSize="13"
                     AcceptsReturn="True"
                     MaxHeight="80"
                     VerticalScrollBarVisibility="Auto"
                     KeyDown="CommandBox_KeyDown"/>
            <Button Grid.Column="1" Content="Send"
                    Click="Send_Click"
                    Background="#c27d1a" Foreground="White"
                    FontWeight="Bold"
                    Padding="12,4" Margin="6,0,0,0"
                    BorderThickness="0" Cursor="Hand"
                    VerticalAlignment="Top"/>
        </Grid>

        <!-- Terminal checklist -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#3e3e3e" BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#2d2d2d" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Terminals" Foreground="#999" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="All" FontSize="10" Margin="10,0,4,0" Padding="6,1"
                                Click="CheckAll_Click"
                                Background="Transparent" Foreground="#3a96dd" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="None" FontSize="10" Padding="6,1"
                                Click="UncheckAll_Click"
                                Background="Transparent" Foreground="#3a96dd" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TerminalList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,4" BorderBrush="#333" BorderThickness="0,0,0,1">
                                    <CheckBox IsChecked="{Binding IsBroadcastTarget}"
                                              Foreground="#CCC" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                     Fill="{Binding AccentColor, Converter={StaticResource StringToBrush}}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayIndex}" Foreground="#888"
                                                       FontSize="10" FontFamily="Consolas" Margin="0,0,4,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Foreground="#CCC"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Bottom bar -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="Enter = Send  |  Shift+Enter = newline"
                       Foreground="#666" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Close" Click="Close_Click"
                    Padding="12,4" Background="#333" Foreground="#CCC"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
