<Window x:Class="MultiTerminalManagement.Views.CreateTerminalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Terminal"
        Width="500" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e1e">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Name -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Name:"
                   Foreground="#CCCCCC"
                   VerticalAlignment="Center"/>
        <TextBox x:Name="NameBox"
                 Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                 Background="#2d2d2d"
                 Foreground="#CCCCCC"
                 CaretBrush="#CCCCCC"
                 BorderBrush="#3e3e3e"
                 Padding="4"
                 Text="Terminal"/>

        <!-- Type -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Type:"
                   Foreground="#CCCCCC"
                   VerticalAlignment="Center"/>
        <ComboBox x:Name="TypeCombo"
                  Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                  SelectedIndex="0"
                  Padding="4">
            <ComboBoxItem Content="CMD"/>
            <ComboBoxItem Content="PowerShell"/>
        </ComboBox>

        <!-- Working Directory -->
        <TextBlock Grid.Row="4" Grid.Column="0"
                   Text="Directory:"
                   Foreground="#CCCCCC"
                   VerticalAlignment="Center"/>
        <TextBox x:Name="PathBox"
                 Grid.Row="4" Grid.Column="1"
                 Background="#2d2d2d"
                 Foreground="#CCCCCC"
                 CaretBrush="#CCCCCC"
                 BorderBrush="#3e3e3e"
                 Padding="4"/>
        <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal">
            <Button Content="..." Width="30" Margin="4,0,0,0"
                    Click="Browse_Click" ToolTip="Browse folder"/>
            <Button Content="X" Width="30" Margin="4,0,0,0"
                    Click="ClearPath_Click" ToolTip="Clear path"
                    Foreground="#999" Background="Transparent" BorderThickness="0"/>
        </StackPanel>

        <!-- Save alias for path -->
        <TextBlock Grid.Row="6" Grid.Column="0"
                   Text="Alias:"
                   Foreground="#CCCCCC"
                   VerticalAlignment="Center"/>
        <TextBox x:Name="AliasBox"
                 Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                 Background="#2d2d2d"
                 Foreground="#CCCCCC"
                 CaretBrush="#CCCCCC"
                 BorderBrush="#3e3e3e"
                 Padding="4"
                 ToolTip="Alias name for this path (used for auto-naming terminals)"/>

        <!-- Saved paths list -->
        <TextBlock Grid.Row="8" Grid.Column="0"
                   Text="Saved:"
                   Foreground="#888"
                   VerticalAlignment="Top"
                   FontSize="11"/>
        <ItemsControl x:Name="SavedPathsList"
                      Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                      MaxHeight="90"
                      Background="#2d2d2d"
                      BorderBrush="#3e3e3e"
                      BorderThickness="1">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2d2d2d" Padding="6,3" Cursor="Hand"
                            MouseLeftButtonDown="SavedPath_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Name badge -->
                            <Border Grid.Column="0" Background="#0e639c" CornerRadius="3"
                                    Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="White"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <!-- Path -->
                            <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="#999"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       FontSize="11"/>
                            <Button Grid.Column="2" Content="−" FontSize="12"
                                    Click="RemoveSavedPath_Click"
                                    Background="Transparent" Foreground="#FF6666"
                                    BorderThickness="0" Cursor="Hand"
                                    Padding="6,0"
                                    ToolTip="Remove this path"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Hint -->
        <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="Click a saved path to auto-fill name &amp; directory."
                   Foreground="#666" FontSize="11" FontStyle="Italic"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Create" Width="75" Margin="0,0,8,0"
                    Click="Create_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="75"
                    Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
