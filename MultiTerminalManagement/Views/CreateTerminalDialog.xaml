<Window x:Class="MultiTerminalManagement.Views.CreateTerminalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Terminal"
        Width="460" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e1e">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Profile -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Profile:"
                   Foreground="#CCCCCC"
                   VerticalAlignment="Center"/>
        <ComboBox x:Name="ProfileCombo" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Padding="4"
                  SelectionChanged="ProfileCombo_SelectionChanged">
            <ComboBoxItem Content="(None)" IsSelected="True"/>
        </ComboBox>

        <!-- Name -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Name:"
                   Foreground="#CCCCCC"
                   VerticalAlignment="Center"/>
        <TextBox x:Name="NameBox"
                 Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                 Background="#2d2d2d"
                 Foreground="#CCCCCC"
                 CaretBrush="#CCCCCC"
                 BorderBrush="#3e3e3e"
                 Padding="4"
                 Text="Terminal"/>

        <!-- Type -->
        <TextBlock Grid.Row="4" Grid.Column="0"
                   Text="Type:"
                   Foreground="#CCCCCC"
                   VerticalAlignment="Center"/>
        <ComboBox x:Name="TypeCombo"
                  Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                  SelectedIndex="0"
                  Padding="4">
            <ComboBoxItem Content="CMD"/>
            <ComboBoxItem Content="PowerShell"/>
        </ComboBox>

        <!-- Working Directory -->
        <TextBlock Grid.Row="6" Grid.Column="0"
                   Text="Directory:"
                   Foreground="#CCCCCC"
                   VerticalAlignment="Center"/>
        <TextBox x:Name="PathBox"
                 Grid.Row="6" Grid.Column="1"
                 Background="#2d2d2d"
                 Foreground="#CCCCCC"
                 CaretBrush="#CCCCCC"
                 BorderBrush="#3e3e3e"
                 Padding="4"/>
        <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal">
            <Button Content="..." Width="30" Margin="4,0,0,0"
                    Click="Browse_Click" ToolTip="Browse folder"/>
            <Button Content="X" Width="30" Margin="4,0,0,0"
                    Click="ClearPath_Click" ToolTip="Clear path"
                    Foreground="#999" Background="Transparent" BorderThickness="0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Create" Width="75" Margin="0,0,8,0"
                    Click="Create_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="75"
                    Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
