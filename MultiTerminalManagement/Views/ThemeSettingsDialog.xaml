<Window x:Class="MultiTerminalManagement.Views.ThemeSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme Settings"
        Width="460" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeMainBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Theme Colors" Foreground="{DynamicResource ThemeText}"
                   FontSize="16" FontWeight="Bold"/>

        <!-- Color fields -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="Accent:" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
            <TextBox x:Name="AccentBox" Grid.Row="0" Grid.Column="1" Padding="4"
                     Background="#2d2d2d" Foreground="#CCCCCC" CaretBrush="#CCCCCC" BorderBrush="#3e3e3e"
                     TextChanged="ColorBox_TextChanged"/>
            <Rectangle x:Name="AccentPreview" Grid.Row="0" Grid.Column="2" Width="22" Height="22"
                       Margin="4,0,0,0" RadiusX="3" RadiusY="3" Stroke="#555" StrokeThickness="1"/>

            <TextBlock Grid.Row="2" Text="Header BG:" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
            <TextBox x:Name="HeaderBgBox" Grid.Row="2" Grid.Column="1" Padding="4"
                     Background="#2d2d2d" Foreground="#CCCCCC" CaretBrush="#CCCCCC" BorderBrush="#3e3e3e"
                     TextChanged="ColorBox_TextChanged"/>
            <Rectangle x:Name="HeaderBgPreview" Grid.Row="2" Grid.Column="2" Width="22" Height="22"
                       Margin="4,0,0,0" RadiusX="3" RadiusY="3" Stroke="#555" StrokeThickness="1"/>

            <TextBlock Grid.Row="4" Text="Main BG:" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
            <TextBox x:Name="MainBgBox" Grid.Row="4" Grid.Column="1" Padding="4"
                     Background="#2d2d2d" Foreground="#CCCCCC" CaretBrush="#CCCCCC" BorderBrush="#3e3e3e"
                     TextChanged="ColorBox_TextChanged"/>
            <Rectangle x:Name="MainBgPreview" Grid.Row="4" Grid.Column="2" Width="22" Height="22"
                       Margin="4,0,0,0" RadiusX="3" RadiusY="3" Stroke="#555" StrokeThickness="1"/>

            <TextBlock Grid.Row="6" Text="Input BG:" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
            <TextBox x:Name="InputBgBox" Grid.Row="6" Grid.Column="1" Padding="4"
                     Background="#2d2d2d" Foreground="#CCCCCC" CaretBrush="#CCCCCC" BorderBrush="#3e3e3e"
                     TextChanged="ColorBox_TextChanged"/>
            <Rectangle x:Name="InputBgPreview" Grid.Row="6" Grid.Column="2" Width="22" Height="22"
                       Margin="4,0,0,0" RadiusX="3" RadiusY="3" Stroke="#555" StrokeThickness="1"/>

            <TextBlock Grid.Row="8" Text="Text Color:" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
            <TextBox x:Name="TextColorBox" Grid.Row="8" Grid.Column="1" Padding="4"
                     Background="#2d2d2d" Foreground="#CCCCCC" CaretBrush="#CCCCCC" BorderBrush="#3e3e3e"
                     TextChanged="ColorBox_TextChanged"/>
            <Rectangle x:Name="TextColorPreview" Grid.Row="8" Grid.Column="2" Width="22" Height="22"
                       Margin="4,0,0,0" RadiusX="3" RadiusY="3" Stroke="#555" StrokeThickness="1"/>

            <TextBlock Grid.Row="10" Text="Muted Text:" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
            <TextBox x:Name="MutedTextBox" Grid.Row="10" Grid.Column="1" Padding="4"
                     Background="#2d2d2d" Foreground="#CCCCCC" CaretBrush="#CCCCCC" BorderBrush="#3e3e3e"
                     TextChanged="ColorBox_TextChanged"/>
            <Rectangle x:Name="MutedTextPreview" Grid.Row="10" Grid.Column="2" Width="22" Height="22"
                       Margin="4,0,0,0" RadiusX="3" RadiusY="3" Stroke="#555" StrokeThickness="1"/>
        </Grid>

        <!-- Font Size -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock Text="Font Size:" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="FontSizeCombo" Width="60" SelectedIndex="1">
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="12"/>
                <ComboBoxItem Content="14"/>
                <ComboBoxItem Content="16"/>
                <ComboBoxItem Content="18"/>
                <ComboBoxItem Content="20"/>
            </ComboBox>
        </StackPanel>

        <!-- Presets -->
        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <TextBlock Text="Presets:" Foreground="{DynamicResource ThemeMutedText}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="Dark (Default)" Click="PresetDark_Click" Padding="8,3" Margin="0,0,4,0"
                    Background="#3c3c3c" Foreground="#E0E0E0" BorderBrush="#555" BorderThickness="1" Cursor="Hand"/>
            <Button Content="Darker" Click="PresetDarker_Click" Padding="8,3" Margin="0,0,4,0"
                    Background="#3c3c3c" Foreground="#E0E0E0" BorderBrush="#555" BorderThickness="1" Cursor="Hand"/>
            <Button Content="Blue Accent" Click="PresetBlue_Click" Padding="8,3" Margin="0,0,4,0"
                    Background="#3c3c3c" Foreground="#E0E0E0" BorderBrush="#555" BorderThickness="1" Cursor="Hand"/>
            <Button Content="Green Accent" Click="PresetGreen_Click" Padding="8,3"
                    Background="#3c3c3c" Foreground="#E0E0E0" BorderBrush="#555" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Apply" Click="Apply_Click" Padding="16,5"
                    Background="#0e639c" Foreground="White" BorderThickness="0" Cursor="Hand"
                    FontWeight="SemiBold"/>
            <Button Content="Close" Click="Close_Click" Padding="16,5" Margin="8,0,0,0"
                    Background="#3c3c3c" Foreground="#E0E0E0" BorderBrush="#555" BorderThickness="1" Cursor="Hand"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
