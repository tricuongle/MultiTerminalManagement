<Window x:Class="MultiTerminalManagement.Views.SessionManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Manager"
        Width="500" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e1e">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Save current session -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SessionNameBox" Grid.Column="0"
                     Background="#2d2d2d" Foreground="#CCCCCC" CaretBrush="#CCCCCC"
                     BorderBrush="#3e3e3e" Padding="4"
                     Text="My Session"/>
            <Button Grid.Column="1" Content="Save Current" Click="SaveSession_Click"
                    Padding="12,4" Margin="6,0,0,0"
                    Background="#0e639c" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <!-- Session list -->
        <ListBox x:Name="SessionList" Grid.Row="2"
                 Background="#252526" Foreground="#E0E0E0"
                 BorderBrush="#3e3e3e">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Foreground="#E0E0E0"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                       Foreground="#888" FontSize="11" Margin="0,0,10,0"/>
                            <TextBlock Foreground="#888" FontSize="11">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} terminal(s)">
                                        <Binding Path="Terminals.Count"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Content="Load Selected" Click="LoadSession_Click" Padding="12,4"
                    Background="#16825d" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Delete Selected" Click="DeleteSession_Click" Padding="12,4" Margin="6,0,0,0"
                    Background="#442222" Foreground="#cc6666" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- Auto-restore option -->
        <CheckBox x:Name="AutoRestoreCheck" Grid.Row="6"
                  Content="Auto-restore last session on startup"
                  Foreground="#CCCCCC"
                  IsChecked="False"
                  Checked="AutoRestoreCheck_Changed"
                  Unchecked="AutoRestoreCheck_Changed"/>
    </Grid>
</Window>
