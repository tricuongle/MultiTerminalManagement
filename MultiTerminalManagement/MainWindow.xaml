<Window x:Class="MultiTerminalManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MultiTerminalManagement.Views"
        xmlns:vm="clr-namespace:MultiTerminalManagement.ViewModels"
        Title="Multi Terminal Manager"
        Height="700" Width="1100"
        MinHeight="400" MinWidth="600"
        Background="{DynamicResource ThemeMainBg}"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="Tab" Modifiers="Ctrl" Command="{Binding CycleTerminalCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl+Shift" Command="{Binding CycleTerminalBackCommand}"/>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="1"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="2"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="3"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="4"/>
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="5"/>
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="6"/>
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="7"/>
        <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="8"/>
        <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="9"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Single unified header bar -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBg}" Padding="4,3">
            <DockPanel>
                <!-- Right side: layout preset buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style x:Key="LayoutBtn" TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource ThemeButtonBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedText}"/>
                            <Setter Property="BorderBrush" Value="#555"/>
                            <Setter Property="BorderThickness" Value="1,1,0,1"/>
                            <Setter Property="Padding" Value="8,3"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontFamily" Value="Segoe UI Symbol,Segoe UI"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#4a4a4a"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <Button x:Name="BtnLayoutTab" Content="Tab" Click="LayoutButton_Click" Tag="Tab"
                            ToolTip="Tab mode" Margin="6,0,0,0" Style="{StaticResource LayoutBtn}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3,0,0,3"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#4a4a4a"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnLayoutEvenGrid" Content="&#x2593;" Click="LayoutButton_Click" Tag="EvenGrid"
                            ToolTip="Even Grid" Style="{StaticResource LayoutBtn}"/>
                    <Button x:Name="BtnLayoutBigTop" Content="&#x2B1C;" Click="LayoutButton_Click" Tag="BigTop"
                            ToolTip="Big Top" Style="{StaticResource LayoutBtn}"/>
                    <Button x:Name="BtnLayoutThreeColumns" Content="&#x2561;" Click="LayoutButton_Click" Tag="ThreeColumns"
                            ToolTip="3 Columns" Style="{StaticResource LayoutBtn}"/>
                    <Button x:Name="BtnLayoutHorizontal" Content="&#x2194;" Click="LayoutButton_Click" Tag="Horizontal"
                            ToolTip="Horizontal" Style="{StaticResource LayoutBtn}"/>
                    <Button x:Name="BtnLayoutVertical" Content="&#x2195;" Click="LayoutButton_Click" Tag="Vertical"
                            ToolTip="Vertical" Style="{StaticResource LayoutBtn}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0,3,3,0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#4a4a4a"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Left side: Tools dropdown, + button -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tools dropdown button -->
                    <Button x:Name="ToolsButton" Content="&#x25BC; Tools"
                            Click="ToolsButton_Click"
                            Background="{DynamicResource ThemeButtonBg}"
                            Foreground="{DynamicResource ThemeText}"
                            FontSize="12"
                            Padding="10,3"
                            BorderBrush="#555" BorderThickness="1"
                            Cursor="Hand"
                            Margin="0,0,4,0"
                            ToolTip="Profiles, Broadcast, Snippets, Sessions, Theme..."/>

                    <Button Content="+"
                            Command="{Binding AddTerminalCommand}"
                            Background="{DynamicResource ThemeAccent}"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            Padding="8,1"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="New Terminal"/>

                    <Border Width="1" Background="#555" Margin="6,2"/>
                </StackPanel>

                <!-- Tabs fill remaining space -->
                <ListBox x:Name="TabHeaderList"
                         ItemsSource="{Binding Terminals}"
                         SelectedItem="{Binding SelectedTerminal}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         VerticalAlignment="Center"
                         MouseRightButtonUp="TabHeaderList_MouseRightButtonUp"
                         Visibility="{Binding IsGridMode, Converter={StaticResource InverseBoolToVis}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="TabBorder"
                                                Background="{DynamicResource ThemeHeaderBg}"
                                                BorderBrush="{DynamicResource ThemeBorder}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Margin="0,0,2,0"
                                                Padding="5,2"
                                                Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ThemeMainBg}"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="TabBorder" Property="Background" Value="#383838"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- Completion indicator -->
                                <Ellipse Width="6" Height="6" Margin="0,0,3,0" VerticalAlignment="Center"
                                         Fill="#13a10e">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCompletedCommand}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <!-- Accent dot -->
                                <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                                         Fill="{Binding AccentColor, Converter={StaticResource StringToBrush}}"/>
                                <!-- Index -->
                                <TextBlock Text="{Binding DisplayIndex}" Foreground="{DynamicResource ThemeMutedText}"
                                           FontSize="10" FontFamily="Consolas"
                                           VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <!-- Type badge -->
                                <Border Background="{Binding AccentColor, Converter={StaticResource StringToBrush}}"
                                        CornerRadius="2" Padding="3,0" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding TypeIcon}" Foreground="White"
                                               FontSize="9" FontFamily="Consolas" FontWeight="Bold"/>
                                </Border>
                                <!-- Name (normal) -->
                                <TextBlock x:Name="TabNameText" Text="{Binding Name}" Foreground="{DynamicResource ThemeText}"
                                           VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                           MouseLeftButtonDown="TabNameText_MouseLeftButtonDown"/>
                                <!-- Name (rename) -->
                                <TextBox x:Name="TabRenameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="Collapsed"
                                         Background="{DynamicResource ThemeMainBg}" Foreground="{DynamicResource ThemeText}"
                                         CaretBrush="{DynamicResource ThemeText}"
                                         BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1"
                                         FontSize="11" MinWidth="60" Padding="2,0"
                                         KeyDown="TabRenameBox_KeyDown"
                                         LostFocus="TabRenameBox_LostFocus"/>
                                <!-- Close button -->
                                <Button Content=" &#x2715;" FontSize="9"
                                        Command="{Binding DataContext.CloseTerminalCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" Foreground="#CC6666"
                                        BorderThickness="0" Cursor="Hand"
                                        Margin="3,0,0,0" Padding="2,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Terminal host -->
        <Grid x:Name="TerminalHost" Grid.Row="1"/>

        <!-- Empty state -->
        <TextBlock Grid.Row="1"
                   Text="Click '+' to get started"
                   Foreground="{DynamicResource ThemeMutedText}"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Terminals.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
