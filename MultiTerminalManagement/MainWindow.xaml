<Window x:Class="MultiTerminalManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MultiTerminalManagement.Views"
        xmlns:vm="clr-namespace:MultiTerminalManagement.ViewModels"
        Title="Multi Terminal Manager"
        Height="700" Width="1100"
        MinHeight="400" MinWidth="600"
        Background="#1e1e1e"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="Tab" Modifiers="Ctrl" Command="{Binding CycleTerminalCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl+Shift" Command="{Binding CycleTerminalBackCommand}"/>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="1"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="2"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="3"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="4"/>
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="5"/>
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="6"/>
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="7"/>
        <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="8"/>
        <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="9"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Single unified header bar: [+ New] [Tabs...] ... [Font] [Grid controls] [Grid toggle] -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="4,3">
            <DockPanel>
                <!-- Right side: controls -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Font:" Foreground="#999" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="FontSizeCombo" Width="50"
                              SelectedIndex="2"
                              SelectionChanged="FontSizeCombo_SelectionChanged">
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="20"/>
                    </ComboBox>

                    <Border Width="1" Background="#555" Margin="8,2"/>

                    <TextBlock Text="Rows:" Foreground="#999" VerticalAlignment="Center" Margin="0,0,4,0"
                               Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox x:Name="RowsCombo" SelectedIndex="1" Width="45"
                              SelectionChanged="RowsCombo_SelectionChanged"
                              Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                    </ComboBox>
                    <TextBlock Text="x" Foreground="#999" VerticalAlignment="Center" Margin="4,0"
                               Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox x:Name="ColumnsCombo" SelectedIndex="1" Width="45"
                              SelectionChanged="ColumnsCombo_SelectionChanged"
                              Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                    </ComboBox>

                    <ToggleButton Content="Grid"
                                  IsChecked="{Binding IsGridMode}"
                                  Foreground="White"
                                  Padding="10,3"
                                  Margin="6,0,0,0"
                                  BorderThickness="0"
                                  Cursor="Hand"/>
                </StackPanel>

                <!-- Left side: + button, profiles, broadcast, snippets, sessions -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+"
                            Command="{Binding AddTerminalCommand}"
                            Background="#0e639c"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            Padding="8,1"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="New Terminal"
                            Margin="0,0,4,0"/>

                    <!-- Profiles dropdown -->
                    <ComboBox x:Name="ProfilesDropdown" Width="100" Margin="2,0"
                              ToolTip="Quick-create from profile"
                              SelectionChanged="ProfilesDropdown_SelectionChanged">
                        <ComboBoxItem Content="Profiles" IsSelected="True" IsEnabled="False"/>
                    </ComboBox>

                    <Border Width="1" Background="#555" Margin="4,2"/>

                    <!-- Broadcast toggle -->
                    <ToggleButton x:Name="BroadcastToggle"
                                  Content="Broadcast"
                                  IsChecked="{Binding IsBroadcastMode}"
                                  Foreground="White"
                                  Padding="8,2"
                                  BorderThickness="0"
                                  Cursor="Hand"
                                  ToolTip="Toggle broadcast mode (send to all terminals)"
                                  Margin="2,0"/>

                    <Border Width="1" Background="#555" Margin="4,2"/>

                    <!-- Snippets -->
                    <Button Content="{}{}"
                            Click="ManageSnippets_Click"
                            Background="Transparent"
                            Foreground="#E0E0E0"
                            FontSize="12"
                            Padding="8,2"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Manage Snippets"
                            Margin="2,0"/>

                    <!-- Sessions -->
                    <Button Content="Sessions"
                            Click="ManageSessions_Click"
                            Background="Transparent"
                            Foreground="#E0E0E0"
                            FontSize="12"
                            Padding="8,2"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Save/Load Sessions"
                            Margin="2,0"/>

                    <Border Width="1" Background="#555" Margin="4,2"/>
                </StackPanel>

                <!-- Tabs fill remaining space -->
                <ListBox x:Name="TabHeaderList"
                         ItemsSource="{Binding Terminals}"
                         SelectedItem="{Binding SelectedTerminal}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         VerticalAlignment="Center"
                         MouseRightButtonUp="TabHeaderList_MouseRightButtonUp"
                         Visibility="{Binding IsGridMode, Converter={StaticResource InverseBoolToVis}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="TabBorder"
                                                Background="#2d2d2d"
                                                BorderBrush="#3e3e3e"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Margin="0,0,2,0"
                                                Padding="5,2"
                                                Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#1e1e1e"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0e639c"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="TabBorder" Property="Background" Value="#383838"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- Completion indicator -->
                                <Ellipse Width="6" Height="6" Margin="0,0,3,0" VerticalAlignment="Center"
                                         Fill="#13a10e">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCompletedCommand}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <!-- Accent dot -->
                                <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                                         Fill="{Binding AccentColor, Converter={StaticResource StringToBrush}}"/>
                                <!-- Index -->
                                <TextBlock Text="{Binding DisplayIndex}" Foreground="#888"
                                           FontSize="10" FontFamily="Consolas"
                                           VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <!-- Type badge -->
                                <Border Background="{Binding AccentColor, Converter={StaticResource StringToBrush}}"
                                        CornerRadius="2" Padding="3,0" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding TypeIcon}" Foreground="White"
                                               FontSize="9" FontFamily="Consolas" FontWeight="Bold"/>
                                </Border>
                                <!-- Name (normal) -->
                                <TextBlock x:Name="TabNameText" Text="{Binding Name}" Foreground="#E0E0E0"
                                           VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                           MouseLeftButtonDown="TabNameText_MouseLeftButtonDown"/>
                                <!-- Name (rename) -->
                                <TextBox x:Name="TabRenameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="Collapsed"
                                         Background="#1e1e1e" Foreground="#E0E0E0" CaretBrush="#E0E0E0"
                                         BorderBrush="#0e639c" BorderThickness="1"
                                         FontSize="11" MinWidth="60" Padding="2,0"
                                         KeyDown="TabRenameBox_KeyDown"
                                         LostFocus="TabRenameBox_LostFocus"/>
                                <!-- Close button -->
                                <Button Content=" &#x2715;" FontSize="9"
                                        Command="{Binding DataContext.CloseTerminalCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" Foreground="#888"
                                        BorderThickness="0" Cursor="Hand"
                                        Margin="3,0,0,0" Padding="2,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Broadcast banner -->
        <Border Grid.Row="1" Background="#c27d1a" Padding="6,3" VerticalAlignment="Top"
                Panel.ZIndex="10"
                Visibility="{Binding IsBroadcastMode, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="BROADCAST MODE: Input will be sent to all checked terminals"
                       Foreground="White" FontWeight="SemiBold" FontSize="11"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Terminal host -->
        <Grid x:Name="TerminalHost" Grid.Row="1"/>

        <!-- Empty state -->
        <TextBlock Grid.Row="1"
                   Text="Click '+' to get started"
                   Foreground="#666"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Terminals.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
