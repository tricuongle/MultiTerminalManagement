<Window x:Class="MultiTerminalManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MultiTerminalManagement.Views"
        xmlns:vm="clr-namespace:MultiTerminalManagement.ViewModels"
        Title="Multi Terminal Manager"
        Height="700" Width="1100"
        MinHeight="400" MinWidth="600"
        Background="#1e1e1e"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <!-- Ctrl+Tab / Ctrl+Shift+Tab: cycle terminals -->
        <KeyBinding Key="Tab" Modifiers="Ctrl" Command="{Binding CycleTerminalCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl+Shift" Command="{Binding CycleTerminalBackCommand}"/>
        <!-- Ctrl+1..9: go to terminal by number -->
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="1"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="2"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="3"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="4"/>
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="5"/>
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="6"/>
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="7"/>
        <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="8"/>
        <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding GoToTerminalCommand}" CommandParameter="9"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="+ New Terminal"
                            Command="{Binding AddTerminalCommand}"
                            Background="#0e639c"
                            Foreground="White"
                            Padding="12,4"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Font size -->
                    <TextBlock Text="Font:" Foreground="#999" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="FontSizeCombo" Width="50"
                              SelectedIndex="2"
                              SelectionChanged="FontSizeCombo_SelectionChanged">
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="20"/>
                    </ComboBox>

                    <Border Width="1" Background="#555" Margin="10,2"/>

                    <!-- Grid layout controls -->
                    <TextBlock Text="Rows:" Foreground="#999" VerticalAlignment="Center" Margin="0,0,4,0"
                               Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox x:Name="RowsCombo" SelectedIndex="1" Width="45"
                              SelectionChanged="RowsCombo_SelectionChanged"
                              Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                    </ComboBox>

                    <TextBlock Text=" x Cols:" Foreground="#999" VerticalAlignment="Center" Margin="4,0,4,0"
                               Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox x:Name="ColumnsCombo" SelectedIndex="1" Width="45"
                              SelectionChanged="ColumnsCombo_SelectionChanged"
                              Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                    </ComboBox>

                    <ToggleButton Content="Grid"
                                  IsChecked="{Binding IsGridMode}"
                                  Foreground="White"
                                  Padding="12,4"
                                  Margin="8,0,0,0"
                                  BorderThickness="0"
                                  Cursor="Hand"/>
                </StackPanel>

                <Border/>
            </DockPanel>
        </Border>

        <!-- Tab header strip (visible in tab mode only) -->
        <Border Grid.Row="1"
                Visibility="{Binding IsGridMode, Converter={StaticResource InverseBoolToVis}}">
            <ListBox x:Name="TabHeaderList"
                     ItemsSource="{Binding Terminals}"
                     SelectedItem="{Binding SelectedTerminal}"
                     Background="#2d2d2d"
                     BorderThickness="0"
                     Padding="4,4,4,0"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="TabHeaderList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="TabHeaderList_PreviewMouseMove"
                     PreviewDrop="TabHeaderList_Drop"
                     PreviewDragOver="TabHeaderList_DragOver"
                     MouseRightButtonUp="TabHeaderList_MouseRightButtonUp">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AllowDrop" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="TabBorder"
                                            Background="#2d2d2d"
                                            BorderBrush="#3e3e3e"
                                            BorderThickness="1,1,1,0"
                                            Margin="0,0,2,0"
                                            Padding="6,4"
                                            Cursor="Hand">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#1e1e1e"/>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0e639c"/>
                                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="TabBorder" Property="Background" Value="#383838"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <!-- Context menu is created in code-behind via MouseRightButtonUp -->
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <!-- Accent dot -->
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{Binding AccentColor, Converter={StaticResource StringToBrush}}"/>
                            <!-- Index -->
                            <TextBlock Text="{Binding DisplayIndex}" Foreground="#888"
                                       FontSize="11" FontFamily="Consolas"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <!-- Type badge -->
                            <Border Background="{Binding AccentColor, Converter={StaticResource StringToBrush}}"
                                    CornerRadius="3" Padding="4,1" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="{Binding TypeIcon}" Foreground="White"
                                           FontSize="9" FontFamily="Consolas" FontWeight="Bold"/>
                            </Border>
                            <!-- Name (normal) -->
                            <TextBlock x:Name="TabNameText" Text="{Binding Name}" Foreground="#E0E0E0"
                                       VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                       MouseLeftButtonDown="TabNameText_MouseLeftButtonDown"/>
                            <!-- Name (rename) -->
                            <TextBox x:Name="TabRenameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="Collapsed"
                                     Background="#1e1e1e" Foreground="#E0E0E0" CaretBrush="#E0E0E0"
                                     BorderBrush="#0e639c" BorderThickness="1"
                                     FontSize="12" MinWidth="60" Padding="2,1"
                                     KeyDown="TabRenameBox_KeyDown"
                                     LostFocus="TabRenameBox_LostFocus"/>
                            <!-- Close button -->
                            <Button Content="  &#x2715;" FontSize="10"
                                    Command="{Binding DataContext.CloseTerminalCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" Foreground="#888"
                                    BorderThickness="0" Cursor="Hand"
                                    Margin="4,0,0,0" Padding="2,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Terminal host - all terminal controls live here permanently -->
        <Grid x:Name="TerminalHost" Grid.Row="2"/>

        <!-- Empty state -->
        <TextBlock Grid.Row="2"
                   Text="Click '+ New Terminal' to get started"
                   Foreground="#666"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Terminals.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
